# produce-counter frontend
# Frontend が呼び出す Backend API の Base URL。
# ホスト上で直接 pnpm dev する場合は backend のデフォルトポート 8787 を使う。
# Docker Compose では docker/compose/docker-compose.dev.yml が http://localhost:13701 に上書きする。
NUXT_PUBLIC_API_BASE_URL=http://localhost:8787

# produce-counter backend
# Backend の待ち受けポート。
# Cloud Run では自動注入される。Docker Compose ではコンテナ内部 8787 をホスト側 13701 に公開する。
PORT=8787
